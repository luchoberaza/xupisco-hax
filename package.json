{
  "name": "xupisco-hax",
  "version": "1.0.0",
  "description": "Xupisco Hax - Desktop client for Haxball without game modifications",
  "main": "dist/main/main.js",
  "scripts": {
    "copy-static": "node scripts/copy-static.js",
    "dev": "tsc && npm run copy-static && node scripts/launch.js",
    "build": "tsc && npm run copy-static",
    "package": "npm run build && electron-builder --win portable",
    "make": "npm run build && electron-builder --win nsis"
  },
  "author": "Lucho/Visionario",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "sharp": "^0.34.5",
    "typescript": "^5.4.5"
  },
  "build": {
    "appId": "com.kembron.xupisco-hax",
    "productName": "Xupisco Hax",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "XupiscoHax-${version}-portable.exe"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  }
}
